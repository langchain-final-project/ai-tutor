# 로컬 API 접속 포트 / 변경할 때만 이 파일을 .env로 복사
API_PORT=8000

# Bearer 개발 API(app.submission_api)용 설정. 학생 API는 로그인 세션 쿠키를 사용한다.
DIDGO_API_TOKEN=local-test-token
DIDGO_DEV_USER_ID=local-student

# 설치된 Ollama Qwen-VL을 사용할 때 지정합니다. 네이티브 API 실행 시에도 export가 필요합니다.
# DIDGO_QWEN_URL=http://127.0.0.1:11434/v1
# DIDGO_QWEN_MODEL=qwen3-vl:4b-instruct-q4_K_M
# Docker API에서 Mac의 Ollama에 연결할 때 URL 호스트는 host.docker.internal을 사용합니다.
