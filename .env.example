# 로컬 API 접속 포트 / 변경할 때만 이 파일을 .env로 복사
API_PORT=8000

# Bearer 개발 API(app.submission_api)용 설정. 학생 API는 로그인 세션 쿠키 사용
DIDGO_API_TOKEN=local-test-token
DIDGO_DEV_USER_ID=local-student

# 설치된 Ollama Qwen-VL을 사용할 때 지정합니다. 네이티브 API 실행 시에도 export가 필요
# DIDGO_QWEN_URL=http://127.0.0.1:11434/v1
# DIDGO_QWEN_MODEL=qwen3-vl:4b-instruct-q4_K_M
# Docker API에서 Mac의 Ollama에 연결할 때 URL 호스트는 host.docker.internal을 사용
# Docker + Ollama를 사용할 때는 위 네이티브 URL 대신 아래 URL과 설치된 OCR 모델명을 지정
# DIDGO_QWEN_URL=http://host.docker.internal:11434/v1

# 텍스트 튜터는 설치된 Ollama 모델을 사용합니다. OCR 모델과 별도로 설정
DIDGO_TUTOR_MODEL=qwen3:4b-instruct-2507-q4_K_M
# 네이티브 API에서는 아래 주소가 기본값이며 Docker에서는 host.docker.internal을 사용
# DIDGO_TUTOR_URL=http://127.0.0.1:11434
# Docker + Ollama용 튜터 URL
# DIDGO_TUTOR_URL=http://host.docker.internal:11434
DIDGO_TUTOR_TIMEOUT=90

# 유형 조회용 공유 문제은행은 네이티브 실행에서 저장소 기본 경로를 사용하며,
# Docker에서는 compose.solution-flow.yaml이 같은 파일을 읽기 전용으로 연결한다.
